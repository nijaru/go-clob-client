# Environment variables for go-clob-client examples
# Copy this file to .env and fill in your values.

# Your Ethereum private key (required for signing orders and deriving API keys)
POLYMARKET_PRIVATE_KEY=0x...

# API credentials (obtain via examples/clob/auth_bootstrap or client.CreateOrDeriveAPIKey)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Token ID for the market you want to trade (find via Gamma API or https://docs.polymarket.com)
POLYMARKET_TOKEN_ID=

# Optional: override the CLOB API host (defaults to https://clob.polymarket.com)
# POLYMARKET_HOST=https://clob.polymarket.com
